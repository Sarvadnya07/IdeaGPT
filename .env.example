# ===========================================================================
# IdeaGPT Root Environment Configuration Template (.env.example)
# Copy this file to .env and supply actual values for your deployment.
# NEVER commit real API keys or database passwords to source control.
# ===========================================================================

# Database Configuration
POSTGRES_USER=ideagpt
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=ideagpt
DATABASE_URL=postgresql+asyncpg://ideagpt:your_secure_database_password_here@localhost:5432/ideagpt

# Redis Configuration (Optional, for caching and task queue)
REDIS_URL=redis://localhost:6379/0

# Environment Mode: development | test | production
APP_ENV=development

# Clerk Authentication
# CLERK_PUBLISHABLE_KEY is used to derive JWKS verification endpoint (public)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
# CLERK_JWT_ISSUER (Optional override, e.g. https://clerk.yourdomain.com)
CLERK_JWT_ISSUER=
# CLERK_AUTHORIZED_PARTY (Optional frontend origin check)
CLERK_AUTHORIZED_PARTY=http://localhost:3000

# AI Provider API Keys (Loaded lazily when provider is enabled)
GROQ_API_KEY=gsk_your_groq_api_key_here
ENABLE_GROQ=true
GROQ_DEFAULT_MODEL=auto

OPENAI_API_KEY=
ENABLE_OPENAI=false

GEMINI_API_KEY=
ENABLE_GEMINI=false

ENABLE_OLLAMA=false
OLLAMA_URL=http://localhost:11434

# Rate Limiting
RATE_LIMIT_ENABLED=true
