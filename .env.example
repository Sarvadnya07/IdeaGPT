# ===========================================================================
# IdeaGPT Root Environment Configuration Template (.env.example)
# This file is a documentation template only. DO NOT add real secrets here.
# For local API development, configure: apps/api/.env
# For local Web development, configure: apps/web/.env.local
# For Vercel cloud deployment, configure Vercel Project Environment Variables.
# ===========================================================================

# ---------------------------------------------------------------------------
# General Application & Environment
# ---------------------------------------------------------------------------
APP_ENV=development
PROJECT_NAME="IdeaGPT API"
VERSION="1.0.0"

# ---------------------------------------------------------------------------
# Database & Cache
# Local: sqlite+aiosqlite:///./ideagpt.db or local PostgreSQL
# Production: postgresql+asyncpg://user:password@host:5432/dbname
# ---------------------------------------------------------------------------
POSTGRES_USER=ideagpt
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_DB=ideagpt
DATABASE_URL=postgresql+asyncpg://ideagpt:your_secure_database_password_here@localhost:5432/ideagpt
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# CORS Allowlist (Comma-separated exact origins, no wildcards in production)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Clerk Authentication (RS256 JWKS)
# ---------------------------------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_AUTHORIZED_PARTY=

# ---------------------------------------------------------------------------
# AI Provider Credentials & Configuration
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_placeholder
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=auto
ENABLE_GROQ=true

OPENAI_API_KEY=
ENABLE_OPENAI=false

GEMINI_API_KEY=
ENABLE_GEMINI=false

ANTHROPIC_API_KEY=
TAVILY_API_KEY=

ENABLE_OLLAMA=false
OLLAMA_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Rate Limiting & Abuse Protection
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
AI_EVALUATION_RATE_LIMIT=5/minute
AI_GENERATION_RATE_LIMIT=10/minute
WRITE_API_RATE_LIMIT=30/minute
DEFAULT_API_RATE_LIMIT=60/minute

