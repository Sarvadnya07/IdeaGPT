# ===========================================================================
# IdeaGPT API Service Environment Configuration Template (.env.example)
# Copy this file to apps/api/.env for local API development.
# In Vercel or cloud environments, configure these as Project Environment Variables.
# ===========================================================================

APP_ENV=development
PROJECT_NAME="IdeaGPT API"
VERSION="1.0.0"

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./ideagpt.db
REDIS_URL=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000

# Rate Limits
RATE_LIMIT_ENABLED=true
AI_EVALUATION_RATE_LIMIT=5/minute
AI_GENERATION_RATE_LIMIT=10/minute
WRITE_API_RATE_LIMIT=30/minute
DEFAULT_API_RATE_LIMIT=60/minute

# Authentication (Clerk JWKS / RS256)
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_AUTHORIZED_PARTY=

# AI Providers
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=auto
ENABLE_GROQ=true

OPENAI_API_KEY=
ENABLE_OPENAI=false

GEMINI_API_KEY=
ENABLE_GEMINI=false

ANTHROPIC_API_KEY=
TAVILY_API_KEY=

ENABLE_OLLAMA=false
OLLAMA_URL=http://localhost:11434

