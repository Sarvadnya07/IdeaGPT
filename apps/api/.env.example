# ============================================================
# IdeaGPT API — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideagpt

# ============================================================
# Clerk Authentication
# ============================================================
# Your Clerk publishable key (safe to expose — used to derive
# the JWKS URL and issuer; never contains secrets).
# Found in: Clerk Dashboard → API Keys → Publishable Key
CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: override the JWT issuer URL explicitly.
# Defaults to the URL derived from CLERK_PUBLISHABLE_KEY.
# Format: https://<your-clerk-frontend-api>
# CLERK_JWT_ISSUER=

# Optional: enforce the `azp` (authorized party) claim.
# Set to your frontend origin, e.g. http://localhost:3000
# CLERK_AUTHORIZED_PARTY=

# CLERK_SECRET_KEY is NOT required for JWT verification.
# Only set this if you need Clerk backend API calls
# (e.g., user management, webhook handling).
# CLERK_SECRET_KEY=sk_test_...

# ============================================================
# Test Mode (NEVER set in production)
# ============================================================
# APP_ENV controls the runtime mode: development | test | production
APP_ENV=development

# CLERK_JWT_TEST_SECRET enables deterministic HS256 test tokens
# ONLY when APP_ENV=test.  NEVER set in production.
# CLERK_JWT_TEST_SECRET=

# ============================================================
# CORS
# Comma-separated list of allowed frontend origins.
# ============================================================
CORS_ORIGINS=http://localhost:3000

# ============================================================
# AI Providers (all optional)
# ============================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================
# Optional
# ============================================================
REDIS_URL=
