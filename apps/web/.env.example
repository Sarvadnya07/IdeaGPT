# ===========================================================================
# IdeaGPT Frontend Environment Variables Template (apps/web/.env.example)
# Copy to apps/web/.env.local for local development.
# Configure these variables in Vercel Project Settings for production.
# ===========================================================================

# === Clerk Authentication ===

# Publishable key (client-side, embedded at build time)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Secret key (server-side ONLY, used by clerkMiddleware at runtime)
# REQUIRED for Vercel deployment — without this, all page routes return 500.
# NEVER prefix with NEXT_PUBLIC_ — this must stay server-side only.
CLERK_SECRET_KEY=sk_test_placeholder

# === Clerk Routes (optional, build time) ===
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# === Backend API ===
# Local: http://localhost:8000/api/v1
# Production: https://<your-backend-api-domain>.vercel.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
